# Приклад конфігурації (repository.md: справжні значення — лише в .env, який не комітиться).
# STORAGE=memory — усе в пам'яті, решта змінних не потрібна.
STORAGE=postgres

# Хмарний Supabase через Supavisor, transaction mode (порт 6543; prepare вимикається сам).
# Supabase Dashboard → Connect → Transaction pooler.
DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Dashboard → Project Settings → API: URL проєкту й publishable (anon) ключ.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-key>

LOG_LEVEL=info
PORT=3000
