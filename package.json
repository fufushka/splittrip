{
  "name": "splittrip",
  "version": "0.1.0",
  "private": true,
  "description": "Облік спільних витрат у подорожі",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"**/*.{ts,js,cjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,js,cjs,json}\"",
    "lint": "eslint --max-warnings=0 .",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "smoke": "node --test test/smoke/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "fastify": "^5.12.5"
  }
}
